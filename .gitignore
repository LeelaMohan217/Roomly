# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# generated native folders (expo prebuild)
/ios
/android

# build outputs
*.apk
*.aab
*.ipa
*.app
build/

# Native signing
.kotlin/
*.orig.*
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Firebase service account key for FCM push. google-services.json is public
# identifiers and may be committed; these must never be.
*service-account*.json
*firebase-adminsdk*.json

# local env files
.env
.env*.local
!.env.example

# Metro
.metro-health-check*

# debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# typescript
*.tsbuildinfo

# test coverage
coverage/

# local planning sheets, kept out of git
docs/roomly-scaling-plan.xlsx

# Claude Code: personal settings stay local, shared ones are committed
.claude/settings.local.json

# editors
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
