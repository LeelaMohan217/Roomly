# Copy to .env and fill in from Supabase: Connect dialog, or Settings > API Keys.
#
# EXPO_PUBLIC_ vars are embedded in the app bundle and are readable by anyone
# who has the APK. That is fine for the publishable key — it is designed for
# client-side use, and RLS is what actually protects the data.
#
# NEVER put the secret key (sb_secret_... / service_role) here. It bypasses
# every policy in 0003_rls.sql.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
